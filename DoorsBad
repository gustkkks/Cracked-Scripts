    end)(),
    Value    = Players:GetPlayers()[1] and Players:GetPlayers()[1].Name or "",
    Callback = function(selected)
        -- Seleção salva internamente
        _G.YuriSelectedPlayer = selected
    end,
})

-- View Player (teleportar câmera até o player)
PlayersSection:Button({
    Title    = "View Player",
    Desc     = "Vai até a posição do player selecionado",
    Icon     = "solar:map-point-bold-duotone",
    Callback = function()
        local name = _G.YuriSelectedPlayer
        if not name then
            WindUI:Notify({
                Title   = "YuriScripts",
                Content = "Selecione um player primeiro!",
                Icon    = "solar:danger-triangle-bold-duotone",
                Duration = 3,
            })
            return
        end

        local target = Players:FindFirstChild(name)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                char.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(3, 0, 0)
                WindUI:Notify({
                    Title   = "YuriScripts",
                    Content = "Teleportado até " .. name,
                    Icon    = "solar:map-point-bold-duotone",
                    Duration = 2,
                })
            end
        else
            WindUI:Notify({
                Title   = "YuriScripts",
                Content = "Player não encontrado ou sem personagem.",
                Icon    = "solar:danger-triangle-bold-duotone",
                Duration = 3,
            })
        end
    end,
})

-- Bring Player (trazer o player até você)
PlayersSection:Button({
    Title    = "Bring Player",
    Desc     = "Traz o player selecionado até você",
    Icon     = "solar:users-group-two-rounded-bold-duotone",
    Callback = function()
        local name = _G.YuriSelectedPlayer
        if not name then
            WindUI:Notify({
                Title   = "YuriScripts",
                Content = "Selecione um player primeiro!",
                Icon    = "solar:danger-triangle-bold-duotone",
                Duration = 3,
            })
            return
        end

        local target = Players:FindFirstChild(name)
        if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
            local myChar = LocalPlayer.Character
            if myChar and myChar:FindFirstChild("HumanoidRootPart") then
                target.Character.HumanoidRootPart.CFrame = myChar.HumanoidRootPart.CFrame + Vector3.new(2, 0, 0)
                WindUI:Notify({
                    Title   = "YuriScripts",
                    Content = name .. " foi trazido até você!",
                    Icon    = "solar:users-group-two-rounded-bold-duotone",
                    Duration = 2,
                })
            end
        else
            WindUI:Notify({
                Title   = "YuriScripts",
                Content = "Player não encontrado ou sem personagem.",
                Icon    = "solar:danger-triangle-bold-duotone",
                Duration = 3,
            })
        end
    end,
})

