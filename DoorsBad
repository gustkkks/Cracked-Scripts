-- ── Noclip ────────────────────────────
local MovSection = TabUniversal:Section({ Title = "Movimento" })

MovSection:Toggle({
    Title    = "Noclip",
    Desc     = "Atravessa paredes e objetos",
    Icon     = "solar:ghost-bold-duotone",
    Value    = false,
    Callback = function(state)
        NoclipEnabled = state
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
        if NoclipEnabled then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = false end
                end
            end)
        else
            local char = LocalPlayer.Character
            if char then
                for _, p in ipairs(char:GetDescendants()) do
                    if p:IsA("BasePart") then p.CanCollide = true end
                end
            end
        end
    end,
})

-- ── ESP ───────────────────────────────
local VisualSection = TabUniversal:Section({ Title = "Visual" })

local function ClearESP()
    for _, v in ipairs(Camera:GetChildren()) do
        if (v:IsA("BillboardGui") and v.Name == "YuriESP_Label") or
           (v:IsA("SelectionBox")  and v.Name == "YuriESP_Box") then
            v:Destroy()
        end
    end
end

local function ApplyESP(char, name)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "YuriESP_Label"; bb.Adornee = hrp
    bb.AlwaysOnTop = true; bb.Size = UDim2.new(0,100,0,22)
    bb.StudsOffset = Vector3.new(0,3.5,0); bb.Parent = Camera

    local lbl = Instance.new("TextLabel"); lbl.Size = UDim2.new(1,0,1,0)
    lbl.BackgroundTransparency = 1; lbl.Text = name
    lbl.TextColor3 = Color3.fromHex("#bf7fff")
    lbl.TextStrokeTransparency = 0; lbl.TextStrokeColor3 = Color3.new(0,0,0)
    lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 14; lbl.Parent = bb

    local box = Instance.new("SelectionBox"); box.Name = "YuriESP_Box"
    box.Adornee = char; box.Color3 = Color3.fromHex("#9b59b6")
    box.LineThickness = 0.05; box.SurfaceTransparency = 0.85
    box.SurfaceColor3 = Color3.fromHex("#6c3483"); box.Parent = Camera
end

VisualSection:Toggle({
    Title    = "ESP de Players",
    Desc     = "Mostra jogadores através das paredes",
    Icon     = "solar:eye-bold-duotone",
    Value    = false,
    Callback = function(state)
        ESPEnabled = state
        ClearESP()
        if ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    ApplyESP(p.Character, p.Name)
                    p.CharacterAdded:Connect(function(c) if ESPEnabled then ApplyESP(c, p.Name) end end)
                end
            end
        end
    end,
})

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(c)
        if ESPEnabled and p ~= LocalPlayer then ApplyESP(c, p.Name) end
    end)
end)

-- ── Instant Interact ──────────────────
local InteractSection = TabUniversal:Section({ Title = "Interação" })

InteractSection:Toggle({
    Title    = "Instant Interact",
    Desc     = "Interage instantaneamente com objetos",
    Icon     = "solar:hand-stars-bold-duotone",
    Value    = false,
    Callback = function(state)
        InstantInteract = state
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                v.HoldDuration        = state and 0 or 0.6
                v.RequiresLineOfSight = not state
            end
        end
        if state then
            workspace.DescendantAdded:Connect(function(obj)
                if InstantInteract and obj:IsA("ProximityPrompt") then
                    obj.HoldDuration = 0; obj.RequiresLineOfSight = false
                end
            end)
        end
    end,
})

-- ── Players ───────────────────────────
local PlayersSection = TabUniversal:Section({ Title = "Gerenciar Players" })

local function GetPlayerNames()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do table.insert(t, p.Name) end
    if #t == 0 then t = {"Nenhum player"} end
    return t
end

-- Dropdown usando strings simples, sem Value (nil por padrão)
PlayersSection:Dropdown({
    Title    = "Lista de Players",
    Desc     = "Selecione um jogador",
    Icon     = "solar:users-group-rounded-bold-duotone",
    Values   = GetPlayerNames(),
    Callback = function(opt)
        SelectedPlayer = tostring(opt)
    end,
})

local function NotifyNoPlayer()
    WindUI:Notify({ Title="YuriScripts", Content="Selecione um player no Dropdown!", Icon="solar:danger-triangle-bold-duotone", Duration=3 })
end

local function GetTargetHRP()
    if not SelectedPlayer or SelectedPlayer == "Nenhum player" then return nil end
    local t = Players:FindFirstChild(SelectedPlayer)
    if t and t.Character then return t.Character:FindFirstChild("HumanoidRootPart") end
    return nil
end

PlayersSection:Button({
    Title    = "View Player",
    Desc     = "Teleporta você até o player selecionado",
    Icon     = "solar:map-point-bold-duotone",
    Callback = function()
        local hrp = GetTargetHRP()
        if not hrp then NotifyNoPlayer(); return end
        local c = LocalPlayer.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            c.HumanoidRootPart.CFrame = hrp.CFrame + Vector3.new(3,0,0)
            WindUI:Notify({ Title="YuriScripts", Content="Teleportado até "..SelectedPlayer, Duration=2 })
        end
    end,
})

PlayersSection:Button({
    Title    = "Bring Player",
    Desc     = "Traz o player selecionado até você",
    Icon     = "solar:users-group-two-rounded-bold-duotone",
    Callback = function()
        local hrp = GetTargetHRP()
        if not hrp then NotifyNoPlayer(); return end
        local c = LocalPlayer.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            hrp.CFrame = c.HumanoidRootPart.CFrame + Vector3.new(2,0,0)
            WindUI:Notify({ Title="YuriScripts", Content=SelectedPlayer.." trazido até você!", Duration=2 })
        end
    end,
})

