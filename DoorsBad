-- Players - Dropdown com strings simples usa Value = 1 (indice)
local function GetPlayerNames()
    local t = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then table.insert(t, p.Name) end
    end
    if #t == 0 then t = { "Nenhum player" } end
    return t
end

TabUniversal:Dropdown({
    Title    = "Lista de Players",
    Desc     = "Selecione um jogador da sessao",
    Values   = GetPlayerNames(),
    Value    = 1,
    Callback = function(val)
        if val ~= "Nenhum player" then
            SelectedPlayer = val
            WindUI:Notify({ Title = "Selecionado", Content = val, Duration = 2 })
        end
    end,
})

TabUniversal:Space()

TabUniversal:Button({
    Title    = "View Player",
    Desc     = "Teleporta voce ate o player selecionado",
    Callback = function()
        if not SelectedPlayer then
            WindUI:Notify({ Title="YuriScripts", Content="Selecione um player!", Duration=3 })
            return
        end
        local t = Players:FindFirstChild(SelectedPlayer)
        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local c = LocalPlayer.Character
            if c and c:FindFirstChild("HumanoidRootPart") then
                c.HumanoidRootPart.CFrame = t.Character.HumanoidRootPart.CFrame + Vector3.new(3,0,0)
                WindUI:Notify({ Title="YuriScripts", Content="Teleportado ate "..SelectedPlayer, Duration=2 })
            end
        end
    end,
})

TabUniversal:Space()

TabUniversal:Button({
    Title    = "Bring Player",
    Desc     = "Traz o player selecionado ate voce",
    Callback = function()
        if not SelectedPlayer then
            WindUI:Notify({ Title="YuriScripts", Content="Selecione um player!", Duration=3 })
            return
        end
        local t = Players:FindFirstChild(SelectedPlayer)
        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local c = LocalPlayer.Character
            if c and c:FindFirstChild("HumanoidRootPart") then
                t.Character.HumanoidRootPart.CFrame = c.HumanoidRootPart.CFrame + Vector3.new(2,0,0)
                WindUI:Notify({ Title="YuriScripts", Content=SelectedPlayer.." trazido!", Duration=2 })
            end
        end
    end,
})

