-- ESP
ESPFolder = Instance.new("Folder")
ESPFolder.Name = "YuriESP"
ESPFolder.Parent = Camera

local function ClearESP()
    for _, v in ipairs(Camera:GetChildren()) do
        if v.Name == "ESP_BillboardGui" then
            v:Destroy()
        end
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            for _, part in ipairs(player.Character:GetDescendants()) do
                if part:IsA("SelectionBox") then
                    part:Destroy()
                end
            end
        end
    end
end

local function CreateESP(player)
    if player == LocalPlayer then return end

    local function applyESP(char)
        if not char then return end

        -- Box no HumanoidRootPart
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        -- BillboardGui com nome
        local billboard = Instance.new("BillboardGui")
        billboard.Name        = "ESP_BillboardGui"
        billboard.Adornee     = hrp
        billboard.AlwaysOnTop = true
        billboard.Size        = UDim2.new(0, 80, 0, 20)
        billboard.StudsOffset = Vector3.new(0, 3.5, 0)
        billboard.Parent      = Camera

        local label = Instance.new("TextLabel")
        label.Size            = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.Text            = player.Name
        label.TextColor3      = Color3.fromHex("#9b59b6")
        label.TextStrokeTransparency = 0
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        label.Font            = Enum.Font.GothamBold
        label.TextSize        = 14
        label.Parent          = billboard

        -- SelectionBox
        local box = Instance.new("SelectionBox")
        box.Adornee       = char
        box.Color3        = Color3.fromHex("#9b59b6")
        box.LineThickness = 0.05
        box.SurfaceTransparency = 0.8
        box.SurfaceColor3 = Color3.fromHex("#6c3483")
        box.Parent        = Camera
    end

    applyESP(player.Character)
    player.CharacterAdded:Connect(applyESP)
end

VisualSection:Toggle({
    Title    = "ESP de Players",
    Desc     = "Mostra todos os jogadores através das paredes",
    Icon     = "solar:eye-bold-duotone",
    Value    = false,
    Callback = function(state)
        ESPEnabled = state
        ClearESP()
        if ESPEnabled then
            for _, player in ipairs(Players:GetPlayers()) do
                CreateESP(player)
            end
        end
    end,
})

-- Listener para novos players entrando
Players.PlayerAdded:Connect(function(player)
    if ESPEnabled then
        CreateESP(player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    -- Limpa ESP do player que saiu
    for _, v in ipairs(Camera:GetChildren()) do
        if v:IsA("BillboardGui") and v.Name == "ESP_BillboardGui" then
            if v.Adornee and v.Adornee.Parent and
               v.Adornee.Parent.Parent == Players and
               v.Adornee.Parent.Parent:FindFirstChild(v.Adornee.Parent.Name) == nil then
                v:Destroy()
            end
        end
    end
end)

