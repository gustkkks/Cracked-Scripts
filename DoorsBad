local InteractSection = TabUniversal:Section({ Title = "Interação" })

-- Instant Interact
InteractSection:Toggle({
    Title    = "Instant Interact",
    Desc     = "Interage instantaneamente com objetos do jogo",
    Icon     = "solar:hand-stars-bold-duotone",
    Value    = false,
    Callback = function(state)
        InstantInteract = state

        if InstantInteract then
            -- Força interação imediata com ProximityPrompts
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") then
                    v.HoldDuration = 0
                    v.RequiresLineOfSight = false
                end
            end
            workspace.DescendantAdded:Connect(function(obj)
                if InstantInteract and obj:IsA("ProximityPrompt") then
                    obj.HoldDuration = 0
                    obj.RequiresLineOfSight = false
                end
            end)
        else
            -- Restaura ProximityPrompts (padrão do jogo geralmente é 0 mesmo)
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("ProximityPrompt") then
                    v.HoldDuration = 0.6
                    v.RequiresLineOfSight = true
                end
            end
        end
    end,
})

