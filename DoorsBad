-- ── Movimento ─────────────────────────
local MovSection = TabUniversal:Section({ Title = "Movimento" })

MovSection:Toggle({
    Title    = "Noclip",
    Desc     = "Atravessa paredes e objetos",
    Icon     = "solar:ghost-bold-duotone",
    Value    = false,
    Callback = function(state)
        NoclipEnabled = state

        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end

        if NoclipEnabled then
            NoclipConnection = RunService.Stepped:Connect(function()
                local char = LocalPlayer.Character
                if not char then return end
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end)
        else
            local char = LocalPlayer.Character
            if char then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = true
                    end
                end
            end
        end
    end,
})

-- ── Visual ────────────────────────────
local VisualSection = TabUniversal:Section({ Title = "Visual" })

local function ClearESP()
    for _, v in ipairs(Camera:GetChildren()) do
        if (v:IsA("BillboardGui") and v.Name == "YuriESP_Label") or
           (v:IsA("SelectionBox") and v.Name == "YuriESP_Box") then
            v:Destroy()
        end
    end
end

local function ApplyESP(char, playerName)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bb = Instance.new("BillboardGui")
    bb.Name        = "YuriESP_Label"
    bb.Adornee     = hrp
    bb.AlwaysOnTop = true
    bb.Size        = UDim2.new(0, 100, 0, 22)
    bb.StudsOffset = Vector3.new(0, 3.5, 0)
    bb.Parent      = Camera

    local lbl = Instance.new("TextLabel")
    lbl.Size                     = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency   = 1
    lbl.Text                     = playerName
    lbl.TextColor3               = Color3.fromHex("#bf7fff")
    lbl.TextStrokeTransparency   = 0
    lbl.TextStrokeColor3         = Color3.fromRGB(0, 0, 0)
    lbl.Font                     = Enum.Font.GothamBold
    lbl.TextSize                 = 14
    lbl.Parent                   = bb

    local box = Instance.new("SelectionBox")
    box.Name                 = "YuriESP_Box"
    box.Adornee              = char
    box.Color3               = Color3.fromHex("#9b59b6")
    box.LineThickness        = 0.05
    box.SurfaceTransparency  = 0.85
    box.SurfaceColor3        = Color3.fromHex("#6c3483")
    box.Parent               = Camera
end

VisualSection:Toggle({
    Title    = "ESP de Players",
    Desc     = "Mostra jogadores através das paredes",
    Icon     = "solar:eye-bold-duotone",
    Value    = false,
    Callback = function(state)
        ESPEnabled = state
        ClearESP()
        if ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    ApplyESP(p.Character, p.Name)
                    p.CharacterAdded:Connect(function(char)
                        if ESPEnabled then ApplyESP(char, p.Name) end
                    end)
                end
            end
        end
    end,
})

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        if ESPEnabled and p ~= LocalPlayer then
            ApplyESP(char, p.Name)
        end
    end)
end)

-- ── Interação ─────────────────────────
local InteractSection = TabUniversal:Section({ Title = "Interação" })

InteractSection:Toggle({
    Title    = "Instant Interact",
    Desc     = "Interage instantaneamente com objetos",
    Icon     = "solar:hand-stars-bold-duotone",
    Value    = false,
    Callback = function(state)
        InstantInteract = state
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                v.HoldDuration        = InstantInteract and 0 or 0.6
                v.RequiresLineOfSight = not InstantInteract
            end
        end
        if InstantInteract then
            workspace.DescendantAdded:Connect(function(obj)
                if InstantInteract and obj:IsA("ProximityPrompt") then
                    obj.HoldDuration        = 0
                    obj.RequiresLineOfSight = false
                end
            end)
        end
    end,
})

-- ── Gerenciar Players ─────────────────
local PlayersSection = TabUniversal:Section({ Title = "Gerenciar Players" })

-- Monta lista de nomes (strings simples, sem Value numérico!)
local function GetPlayerNames()
    local names = {}
    for _, p in ipairs(Players:GetPlayers()) do
        table.insert(names, p.Name)
    end
    if #names == 0 then
        table.insert(names, "Nenhum player")
    end
    return names
end

local playerNames = GetPlayerNames()
-- Value = nil para não forçar índice — WindUI aceita nil no dropdown simples
PlayersSection:Dropdown({
    Title    = "Lista de Players",
    Desc     = "Selecione um jogador da sessão",
    Icon     = "solar:users-group-rounded-bold-duotone",
    Values   = playerNames,
    Value    = nil,
    Callback = function(option)
        -- WindUI retorna a string selecionada diretamente
        SelectedPlayer = tostring(option)
    end,
})

local function NotifyNoPlayer()
    WindUI:Notify({
        Title    = "YuriScripts",
        Content  = "Selecione um player no Dropdown primeiro!",
        Icon     = "solar:danger-triangle-bold-duotone",
        Duration = 3,
    })
end

local function GetTargetHRP()
    if not SelectedPlayer or SelectedPlayer == "Nenhum player" then return nil end
    local target = Players:FindFirstChild(SelectedPlayer)
    if target and target.Character then
        return target.Character:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

PlayersSection:Button({
    Title    = "View Player",
    Desc     = "Teleporta você até o player selecionado",
    Icon     = "solar:map-point-bold-duotone",
    Callback = function()
        local hrp = GetTargetHRP()
        if not hrp then NotifyNoPlayer(); return end
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            myChar.HumanoidRootPart.CFrame = hrp.CFrame + Vector3.new(3, 0, 0)
            WindUI:Notify({
                Title    = "YuriScripts",
                Content  = "Teleportado até " .. SelectedPlayer,
                Icon     = "solar:map-point-bold-duotone",
                Duration = 2,
            })
        end
    end,
})

PlayersSection:Button({
    Title    = "Bring Player",
    Desc     = "Traz o player selecionado até você",
    Icon     = "solar:users-group-two-rounded-bold-duotone",
    Callback = function()
        local hrp = GetTargetHRP()
        if not hrp then NotifyNoPlayer(); return end
        local myChar = LocalPlayer.Character
        if myChar and myChar:FindFirstChild("HumanoidRootPart") then
            hrp.CFrame = myChar.HumanoidRootPart.CFrame + Vector3.new(2, 0, 0)
            WindUI:Notify({
                Title    = "YuriScripts",
                Content  = SelectedPlayer .. " foi trazido até você!",
                Icon     = "solar:users-group-two-rounded-bold-duotone",
                Duration = 2,
            })
        end
    end,
})

