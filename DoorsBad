-- ESP
local function ClearESP()
    for _, v in ipairs(Camera:GetChildren()) do
        if (v:IsA("BillboardGui") and v.Name == "YuriESP_Label") or
           (v:IsA("SelectionBox")  and v.Name == "YuriESP_Box") then
            v:Destroy()
        end
    end
end

local function ApplyESP(char, name)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bb = Instance.new("BillboardGui")
    bb.Name = "YuriESP_Label"; bb.Adornee = hrp
    bb.AlwaysOnTop = true; bb.Size = UDim2.new(0,100,0,22)
    bb.StudsOffset = Vector3.new(0,3.5,0); bb.Parent = Camera

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,1,0); lbl.BackgroundTransparency = 1
    lbl.Text = name; lbl.TextColor3 = Color3.fromHex("#bf7fff")
    lbl.TextStrokeTransparency = 0; lbl.TextStrokeColor3 = Color3.new(0,0,0)
    lbl.Font = Enum.Font.GothamBold; lbl.TextSize = 14; lbl.Parent = bb

    local box = Instance.new("SelectionBox")
    box.Name = "YuriESP_Box"; box.Adornee = char
    box.Color3 = Color3.fromHex("#9b59b6"); box.LineThickness = 0.05
    box.SurfaceTransparency = 0.85; box.SurfaceColor3 = Color3.fromHex("#6c3483")
    box.Parent = Camera
end

TabUniversal:Toggle({
    Title    = "ESP de Players",
    Desc     = "Mostra jogadores atraves das paredes",
    Value    = false,
    Callback = function(state)
        ESPEnabled = state
        ClearESP()
        if ESPEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    ApplyESP(p.Character, p.Name)
                    p.CharacterAdded:Connect(function(c)
                        if ESPEnabled then ApplyESP(c, p.Name) end
                    end)
                end
            end
        end
    end,
})

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(c)
        if ESPEnabled and p ~= LocalPlayer then ApplyESP(c, p.Name) end
    end)
end)

